# =============================================================================
# .gitignore for gh-actions
# A GitHub composite action repo that installs Node projects with pnpm/npm/yarn.
# Lockfiles (pnpm-lock.yaml, package-lock.json, yarn.lock) are intentionally
# NOT ignored: the action relies on them for --frozen-lockfile / npm ci / --immutable.
# =============================================================================

# -----------------------------------------------------------------------------
# Dependencies
# -----------------------------------------------------------------------------
node_modules/
jspm_packages/
bower_components/
.pnp
.pnp.*
.yarn/*
!.yarn/patches/
!.yarn/plugins/
!.yarn/releases/
!.yarn/sdks/
!.yarn/versions/
.pnpm-store/

# -----------------------------------------------------------------------------
# Package manager debug logs
# -----------------------------------------------------------------------------
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.npm

# -----------------------------------------------------------------------------
# Build output
# -----------------------------------------------------------------------------
dist/
build/
out/
lib-cov/
*.tsbuildinfo
.turbo/
.next/
.nuxt/
.svelte-kit/
.vercel/
.netlify/
.cache/
.parcel-cache/
.rpt2_cache/
.rollup.cache/
.eslintcache
.stylelintcache

# -----------------------------------------------------------------------------
# Tests and coverage
# -----------------------------------------------------------------------------
coverage/
*.lcov
.nyc_output/
junit.xml
test-results/
playwright-report/
blob-report/
playwright/.cache/

# -----------------------------------------------------------------------------
# Environment and secrets
# Never commit real credentials. Keep .env.example (not ignored) as a template.
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets.json
*.secret
.secrets/

# -----------------------------------------------------------------------------
# Logs and temporary files
# -----------------------------------------------------------------------------
logs/
*.log
*.tmp
*.temp
*.bak
*.swp
*.swo
*~
tmp/
temp/

# -----------------------------------------------------------------------------
# Runtime / process files
# -----------------------------------------------------------------------------
pids/
*.pid
*.seed
*.pid.lock

# -----------------------------------------------------------------------------
# GitHub Actions local testing
# -----------------------------------------------------------------------------
# nektos/act local runner files
.actrc
.secrets.act
act-*.log

# -----------------------------------------------------------------------------
# TypeScript / JavaScript tooling
# -----------------------------------------------------------------------------
*.tgz
.npmrc.local
.node_repl_history

# -----------------------------------------------------------------------------
# Editors and IDEs
# -----------------------------------------------------------------------------
# JetBrains (WebStorm, IntelliJ, etc.)
.idea/
*.iml
*.ipr
*.iws

# Visual Studio Code: keep shared project settings, ignore personal ones
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/*.code-snippets
*.code-workspace

# Vim / Neovim
Session.vim
Sessionx.vim
.netrwhist

# Sublime Text
*.sublime-workspace

# Visual Studio
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates

# -----------------------------------------------------------------------------
# Claude Code local files
# Shared project config (.claude/settings.json) stays tracked; local overrides don't.
# -----------------------------------------------------------------------------
.claude/settings.local.json
.claude/*.local.*
CLAUDE.local.md

# -----------------------------------------------------------------------------
# Operating system files
# -----------------------------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.stackdump
[Dd]esktop.ini
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Linux
.directory
.Trash-*
